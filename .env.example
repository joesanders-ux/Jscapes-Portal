# Copy to .env for local development. NEVER commit a real .env file.
# On Railway, set these in the service's Variables tab instead.

# PostgreSQL connection string (Railway provides this from its Postgres service).
DATABASE_URL=postgres://user:password@localhost:5432/jscapes_portal

# Set to "true" only if your database requires SSL (e.g. a public proxy URL).
DATABASE_SSL=false

# Public address of the portal. Used to build invite links and the Google redirect address.
# Production: https://staff.jscapesgls.com
APP_URL=http://localhost:3000

# Google sign-in (optional). Leave both empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
